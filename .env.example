# Copy to .env and fill in. Nothing here is secret by default; the two
# SignalWire values are, so keep .env out of git (see .gitignore).

# --- required to place or receive calls -------------------------------------
# From your SignalWire dashboard: Space name, Project ID, and an API token.
SIGNALWIRE_SPACE_NAME=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=

# --- agent endpoints -------------------------------------------------------
# Basic auth for the agent's own HTTP endpoints. If the password is unset the
# SDK generates a random one at boot, which external callers cannot know, so
# set it before putting this behind a tunnel.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=change-me

# Public base URL when running behind a proxy or tunnel, e.g.
# https://example.ngrok.app -- the agent builds its webhook URLs from this.
SWML_PROXY_URL_BASE=

# Makes the platform sign every webhook POST, and the agent verify it.
# Without it, anyone who finds this endpoint and the basic-auth pair above
# can call the agent's tools directly. Set it before exposing the demo.
SIGNALWIRE_SIGNING_KEY=

# --- optional --------------------------------------------------------------
PORT=3000
